<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HiTunes" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.HiTunes.Splash" parent="Theme.SplashScreen">
        <!-- Background color -->
        <!--<item name="windowSplashScreenBackground">@null</item>-->
        <item name="windowSplashScreenBackground">@color/splash_primary</item>
        <!-- Your app logo -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- Animation duration -->
        <item name="windowSplashScreenAnimationDuration">500</item>
        <!-- Optional: remove status bar until transition -->
        <item name="postSplashScreenTheme">@style/Theme.HiTunes</item>
    </style>
</resources>
